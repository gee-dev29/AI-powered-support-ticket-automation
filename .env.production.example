# Production Environment Configuration
# NEVER commit the actual .env.production file to version control.

# Domain & TLS Configuration
DOMAIN=api.support.example.com
N8N_DOMAIN=n8n.support.example.com

# PostgreSQL Credentials (Least Privilege)
POSTGRES_ROOT_PASSWORD=replace-with-64-char-random-root-password
POSTGRES_APP_PASSWORD=replace-with-64-char-random-app-password
POSTGRES_N8N_PASSWORD=replace-with-64-char-random-n8n-password

# Database URLs
DATABASE_URL=postgresql+psycopg://support_app:replace-with-64-char-random-app-password@postgres:5432/support

# Staff & Admin Security Keys
SUPPORT_ADMIN_API_KEY=replace-with-secure-admin-api-key
SUPPORT_AGENT_API_KEYS=agent-key-1,agent-key-2,agent-key-3
CUSTOMER_AUTH_SECRET=replace-with-secure-hmac-sha256-signing-secret

# Abuse Controls
DISABLE_RATE_LIMIT=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_EMAIL_HOUR=30
ENFORCE_CAPTCHA=true
CAPTCHA_SECRET_KEY=replace-with-turnstile-or-recaptcha-secret
ENABLE_UNVERIFIED_GUEST_ACK=false

# Triage & Notification Destinations
DEFAULT_ALERT_EMAIL=ops-alerts@support.example.com
TRIAGE_EMAIL=triage-urgent@support.example.com
TRIAGE_SLACK_CHANNEL=C0123456789

# External LLM Provider Configuration
OPENAI_API_KEY=sk-proj-replace-with-actual-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=5.0

# -------------------------------------------------------------
# Secret Rotation Procedure:
# 1. Generate new secret: openssl rand -base64 32
# 2. Update .env.production on target host
# 3. Reload services with zero downtime:
#    docker compose -f docker-compose.prod.yml exec api kill -HUP 1
# 4. For DB user passwords, run ALTER USER ... WITH PASSWORD '...' in psql before restarting.
# -------------------------------------------------------------
